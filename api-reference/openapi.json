    {
      "name": "Cells",
      "description": "Metric values for a single H3 cell."
    },
    {
      "name": "Area mappings",
      "description": "Overlaps between statistical areas and H3 cells."
    },
    {
      "name": "Metrics",
      "description": "The metrics available to request."
    }
  ]
}
