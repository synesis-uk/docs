        "pages": [
          "GET /v1/hex-metrics"
        ]
      },
      {
        "group": "Local authorities",
        "openapi": "api-reference/openapi.json",
        "pages": [
          "GET /v1/local-authority-metrics"
        ]
      },
      {
        "group": "Area mappings",
        "openapi": "api-reference/openapi.json",
        "pages": [
          "GET /v1/area-cells",
